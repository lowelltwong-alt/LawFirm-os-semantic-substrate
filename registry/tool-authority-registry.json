{
  "registry_scope": "orchestrator_tool_authority_draft",
  "status": "draft_metadata_only",
  "owner": "semantic-control-plane",
  "global_controls": {
    "tool_authority_must_be_allowlisted": true,
    "side_effects_require_human_approval": true,
    "mcp_compatibility_target_only": true,
    "no_mcp_server_in_mvp": true
  },
  "tool_classes": [
    {
      "class_id": "tool.class.transform.local.v1",
      "side_effect_class": "none",
      "default_policy": "allow_synthetic_only",
      "examples": [
        "normalize input",
        "hash artifact",
        "validate schema"
      ]
    },
    {
      "class_id": "tool.class.evidence.readonly.v1",
      "side_effect_class": "read",
      "default_policy": "approval_if_non_synthetic",
      "examples": [
        "read pinned manifest",
        "read local fixture"
      ]
    },
    {
      "class_id": "tool.class.write.external.v1",
      "side_effect_class": "external_write",
      "default_policy": "forbidden_in_mvp",
      "examples": [
        "send email",
        "write DMS",
        "update billing system"
      ]
    }
  ],
  "tools": [
    {
      "tool_id": "orchestrator.tool.hash_artifact.v1",
      "class_id": "tool.class.transform.local.v1",
      "status": "draft_metadata_only",
      "input_schema_ref": null,
      "output_schema_ref": null,
      "approval_required": false
    },
    {
      "tool_id": "orchestrator.tool.load_pinned_manifest.v1",
      "class_id": "tool.class.evidence.readonly.v1",
      "status": "draft_metadata_only",
      "input_schema_ref": null,
      "output_schema_ref": null,
      "approval_required": false
    }
  ]
}
