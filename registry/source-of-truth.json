  "interpretation_rules": [
    "Do not infer authority from file age or filename similarity.",
    "Use registries before prose when resolving the current schema or route.",
    "Keep ontology, canonical document structure, derived evidence, retrieval/access, policy, AI control plane, and action layers distinct when reading or editing the repo.",
    "Treat source-ingestion-manifest as a metadata-only provenance gate required before an internal document is treated as a governed source; the manifest may not embed source content.",
    "Treat Gold Standard assets as thin canonical KM designations anchored to canonical documents, source artifacts, components, exact spans, and policy references rather than as retrieval outputs or vendor-local labels.",
    "Treat retrieval, answer, and index-migration contracts as derived control surfaces that consume canonical document structure without redefining it.",
    "Treat the AI control plane as tool-neutral repo governance for AI contributors; vendor adapters consume it and do not outrank registries or doctrine.",
    "Treat raw exceptions and pressure vectors as governed evidence and aggregation, not canonical truth.",
    "Treat opportunity, sprint, pilot, validation, scale, and view objects as governed action or presentation layers, not ontology replacements.",
    "Canonical meaning may change only through reviewed governance and promotion decisions."
  ],
  "mutation_boundary": {
    "raw_runtime_may": [
      "route_for_review",
      "aggregate_pressure",
      "attach_evidence_only"
    ],
    "raw_runtime_may_not": [
      "canonical_ontology_write",
      "taxonomy_rewrite",
      "schema_mutation",
      "policy_overwrite",
      "address_system_mutation"
    ],
    "canonical_change_requires": [
      "reviewed_adaptation_proposal",
      "approved_promotion_decision"
    ]
  },
