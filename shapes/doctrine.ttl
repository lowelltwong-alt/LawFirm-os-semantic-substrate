@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix edcs: <https://example.org/fmg/edcs#> .

edcs:DoctrinePositionShape
    a sh:NodeShape ;
    sh:targetClass edcs:DoctrinePosition ;
    sh:property [
        sh:path edcs:doctrineRef ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path edcs:positionLabel ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path edcs:canonicalStatement ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path edcs:comparisonAxes ;
        sh:minCount 1 ;
    ] .
