@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix edcs: <https://example.org/fmg/edcs#> .

edcs:LifecycleShape
    a sh:NodeShape ;
    sh:targetClass edcs:GovernedNode ;
    sh:property [
        sh:path edcs:lifecycleStatus ;
        sh:in (
            "draft"
            "planned"
            "active"
            "deprecated"
            "archived"
        ) ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path edcs:reviewStatus ;
        sh:in (
            "unchecked"
            "reviewed"
            "approved"
            "rejected"
        ) ;
    ] .
