{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lawfirm-os.local/schemas/execution-passport.schema.json",
  "title": "ExecutionPassport",
  "description": "One-action bounded authority granted only after an allowed ExecutionDecision. Required for every bounded model/tool/connector action; never issued for denied or pending-approval decisions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_passport_id",
    "execution_passport_hash",
    "execution_decision_hash",
    "execution_request_hash",
    "context_bundle_hash",
    "contract_surface_sha256",
    "run_id",
    "granted_at",
    "expires_at",
    "allowed_action",
    "allowed_tool_id",
    "allowed_route_id",
    "allowed_event_class",
    "allowed_side_effect_class",
    "single_use"
  ],
  "properties": {
    "schema_version": {"const": "execution_passport.v1"},
    "execution_passport_id": {"type": "string", "minLength": 1},
    "execution_passport_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_decision_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_request_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "context_bundle_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contract_surface_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_id": {"type": "string", "minLength": 1},
    "granted_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "allowed_action": {"type": "string"},
    "allowed_tool_id": {"type": "string"},
    "allowed_route_id": {"type": "string"},
    "allowed_event_class": {"type": "string"},
    "allowed_side_effect_class": {"enum": ["none", "read", "write", "external"]},
    "single_use": {"const": true, "description": "Passport MUST be consumed exactly once. Re-use is a defect."},
    "issuer": {"type": "string"}
  }
}
