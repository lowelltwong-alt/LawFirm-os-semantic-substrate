{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fmg.example/schemas/evaluation-run.schema.json",
  "title": "Evaluation Run",
  "description": "Draft v1 synthetic evaluation harness for grounded-answer readiness. It models evaluation expectations and refusal-safe behavior over synthetic fixtures only; it does not record or claim production retrieval quality, corpus coverage, or answer-quality scores.",
  "type": "object",
  "required": [
    "run_id",
    "schema_type",
    "schema_version",
    "address",
    "address_struct",
    "synthetic_status",
    "evaluation_scope",
    "measurement_boundary",
    "items"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^EVR-[0-9]{6}$"
    },
    "schema_type": {
      "type": "string",
      "const": "evaluation-run"
    },
    "schema_version": {
      "type": "string",
      "const": "v1"
    },
    "address": {
      "$ref": "address.schema.json"
    },
    "address_struct": {
      "$ref": "address_struct.schema.json"
    },
    "synthetic_status": {
      "type": "string",
      "const": "synthetic_test_only"
    },
    "evaluation_scope": {
      "type": "object",
      "required": [
        "purpose",
        "corpus_status"
      ],
      "properties": {
        "purpose": {
          "type": "string",
          "const": "grounded_answer_readiness"
        },
        "corpus_status": {
          "type": "string",
          "const": "synthetic_only_no_internal_corpus"
        }
      },
      "additionalProperties": false
    },
    "measurement_boundary": {
      "type": "object",
      "required": [
        "synthetic_only",
        "production_performance_not_measured",
        "production_performance_not_claimed",
        "approved_internal_corpus_required_for_scores"
      ],
      "properties": {
        "synthetic_only": {
          "type": "boolean",
          "const": true
        },
        "production_performance_not_measured": {
          "type": "boolean",
          "const": true
        },
        "production_performance_not_claimed": {
          "type": "boolean",
          "const": true
        },
        "approved_internal_corpus_required_for_scores": {
          "type": "boolean",
          "const": true
        }
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "evaluation_item_id",
          "synthetic_status",
          "input_question",
          "expected_behavior",
          "allowed_answer_type",
          "validation_criteria",
          "candidate_response"
        ],
        "properties": {
          "evaluation_item_id": {
            "type": "string",
            "pattern": "^EVI-[0-9]{6}$"
          },
          "synthetic_status": {
            "type": "string",
            "const": "synthetic_test_only"
          },
          "input_question": {
            "type": "string",
            "minLength": 8
          },
          "expected_behavior": {
            "type": "string",
            "enum": [
              "grounded_answer_allowed",
              "refusal_required",
              "support_unavailable"
            ]
          },
          "allowed_answer_type": {
            "type": "string",
            "enum": [
              "grounded_answer",
              "refusal",
              "support_unavailable"
            ]
          },
          "expected_source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "expected_evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "expected_retrieval_response_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "expected_answer_event_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "expected_access_decision_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "required_source_policy_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "support_constraint": {
            "type": "object",
            "required": [
              "support_exists_but_unusable",
              "unavailable_reason"
            ],
            "properties": {
              "support_exists_but_unusable": {
                "type": "boolean",
                "const": true
              },
              "unavailable_reason": {
                "type": "string",
                "enum": [
                  "sensitivity_or_allowed_use",
                  "lifecycle_not_active",
                  "ingest_readiness"
                ]
              }
            },
            "additionalProperties": false
          },
          "validation_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "candidate_response": {
            "type": "object",
            "required": [
              "synthetic_status",
              "response_type",
              "response_text"
            ],
            "properties": {
              "synthetic_status": {
                "type": "string",
                "const": "synthetic_test_only"
              },
              "response_type": {
                "type": "string",
                "enum": [
                  "grounded_answer",
                  "refusal",
                  "support_unavailable"
                ]
              },
              "response_text": {
                "type": "string",
                "minLength": 8
              }
            },
            "additionalProperties": false
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "expected_behavior": {
                  "const": "support_unavailable"
                }
              }
            },
            "then": {
              "required": [
                "support_constraint"
              ]
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
