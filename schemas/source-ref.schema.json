{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lawfirm-os.local/schemas/source-ref.schema.json",
  "title": "SourceRef",
  "description": "Provenance pointer to a single retrieved legal source span. Emitted by Legal Knowledge Runtime for every retrieval. Carries provenance and freshness; does NOT carry raw legal text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_ref_id",
    "source_id",
    "content_hash",
    "retrieved_at",
    "source_kind",
    "provenance_tag",
    "freshness_status",
    "instruction_like_content_detected",
    "run_id"
  ],
  "properties": {
    "schema_version": {"const": "source_ref.v1"},
    "source_ref_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "source_kind": {"enum": ["statute", "regulation", "case_law", "secondary", "internal_memo", "synthetic_fixture"]},
    "provenance_tag": {"type": "string", "description": "Substrate-registered provenance tag identifying retrieval connector + corpus."},
    "freshness_status": {"enum": ["fresh", "stale", "unknown"]},
    "freshness_window_days": {"type": "integer", "minimum": 0},
    "instruction_like_content_detected": {"type": "boolean", "description": "True if retrieved content contained instruction-like patterns; must trigger an UntrustedContentAnomalyRecord."},
    "untrusted_content_anomaly_record_id": {"type": "string"},
    "run_id": {"type": "string"}
  }
}
