{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lawfirm-os.local/schemas/prompt-version.schema.json",
  "title": "PromptVersion",
  "description": "Canonical prompt registry entry. Prompts are governed control artifacts, not loose runtime text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prompt_ref",
    "prompt_version",
    "prompt_sha256",
    "prompt_approved",
    "policy_bundle_id",
    "allowed_runtime_surfaces",
    "allowed_data_classes"
  ],
  "properties": {
    "schema_version": {"const": "prompt_version.v1"},
    "prompt_ref": {"type": "string", "minLength": 1},
    "prompt_version": {"type": "string", "minLength": 1},
    "prompt_sha256": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"},
    "prompt_approved": {"type": "boolean"},
    "approved_by": {"type": ["string", "null"]},
    "approved_at": {"type": ["string", "null"], "format": "date-time"},
    "policy_bundle_id": {"type": "string", "minLength": 1},
    "allowed_runtime_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "allowed_data_classes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "notes": {"type": "string"}
  }
}
