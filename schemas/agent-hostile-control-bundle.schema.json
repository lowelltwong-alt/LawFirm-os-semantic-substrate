{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lawfirm-os.local/schemas/agent-hostile-control-bundle.schema.json",
  "title": "AgentHostileControlBundle",
  "description": "Canonical bundle that publishes the registry and schema surfaces for agent-hostile runtime controls.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "bundle_version",
    "status",
    "owner",
    "schema_refs",
    "registry_refs",
    "governance_refs",
    "global_controls"
  ],
  "properties": {
    "schema_version": {"const": "agent_hostile_control_bundle.v1"},
    "bundle_id": {"type": "string", "minLength": 1},
    "bundle_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["active", "draft_metadata_only", "deprecated"]},
    "owner": {"const": "semantic-control-plane"},
    "schema_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "registry_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "governance_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "global_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_deny",
        "agent_identity_required_for_agent_surfaces",
        "audit_required_for_agent_surfaces",
        "runtime_observations_are_not_canon",
        "no_autonomous_writes",
        "synthetic_examples_only"
      ],
      "properties": {
        "default_deny": {"type": "boolean"},
        "agent_identity_required_for_agent_surfaces": {"type": "boolean"},
        "audit_required_for_agent_surfaces": {"type": "boolean"},
        "runtime_observations_are_not_canon": {"type": "boolean"},
        "no_autonomous_writes": {"type": "boolean"},
        "synthetic_examples_only": {"type": "boolean"}
      }
    }
  }
}
