{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lawfirm-os.example/schemas/legal-document-node.schema.json",
  "title": "LawFirm OS Legal Document Node",
  "description": "A structured node in a legal document tree. Nodes are derived retrieval structure and do not redefine canonical document identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_type",
    "schema_version",
    "node_ref",
    "document_ref",
    "node_kind",
    "heading",
    "source_span_refs",
    "boundary_controls"
  ],
  "properties": {
    "schema_type": {
      "const": "legal-document-node"
    },
    "schema_version": {
      "const": "v1"
    },
    "node_ref": {
      "type": "string",
      "minLength": 3
    },
    "document_ref": {
      "type": "string",
      "minLength": 3
    },
    "parent_node_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "node_kind": {
      "enum": [
        "document",
        "section",
        "definition",
        "clause",
        "table",
        "schedule",
        "exhibit",
        "signature",
        "citation",
        "unknown"
      ]
    },
    "heading": {
      "type": "string"
    },
    "ordinal": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": "string"
    },
    "defined_terms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cross_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_span_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "boundary_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "derived_structure_only",
        "may_override_canonical_document"
      ],
      "properties": {
        "derived_structure_only": {
          "const": true
        },
        "may_override_canonical_document": {
          "const": false
        }
      }
    }
  }
}
