{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lawfirm-os.example/schemas/human-approval-record.schema.json",
  "title": "LawFirm OS Human Approval Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "run_id",
    "trace_id",
    "required",
    "approver_role",
    "decision",
    "decision_reason",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "approval_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "required": {
      "type": "boolean"
    },
    "approver_role": {
      "type": "string"
    },
    "decision": {
      "enum": [
        "pending",
        "approved",
        "rejected",
        "approved_with_conditions",
        "not_required"
      ]
    },
    "decision_reason": {
      "type": "string"
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decided_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
