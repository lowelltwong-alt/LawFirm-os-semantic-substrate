{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lawfirm-os.local/schemas/contract-surface-registry.schema.json",
  "title": "LawFirm OS Contract Surface Registry",
  "type": "object",
  "required": [
    "schema_version",
    "registry_id",
    "default_surface_id",
    "surfaces"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "contract_surface_registry.v1"
    },
    "registry_id": {
      "type": "string",
      "minLength": 1
    },
    "default_surface_id": {
      "type": "string",
      "minLength": 1
    },
    "hash_algorithm": {
      "const": "lawfirm_os_contract_surface_sha256.v1"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "surface_id",
          "description",
          "owning_repo",
          "owning_plane",
          "include_patterns",
          "exclude_patterns",
          "consumer_repos",
          "hash_algorithm",
          "unknown_path_policy"
        ],
        "additionalProperties": false,
        "properties": {
          "surface_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "owning_repo": {
            "type": "string",
            "minLength": 1
          },
          "owning_plane": {
            "type": "string",
            "enum": [
              "semantic_substrate"
            ]
          },
          "hash_algorithm": {
            "const": "lawfirm_os_contract_surface_sha256.v1"
          },
          "include_patterns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "exclude_patterns": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "consumer_repos": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "unknown_path_policy": {
            "type": "string",
            "enum": [
              "ignore_unless_included",
              "fail_closed"
            ]
          },
          "contract_authority_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
