{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fmg.example/schemas/index-build.schema.json",
  "title": "Index Build",
  "description": "Derived retrieval index build created from canonical chunks and, where applicable, embeddings. Index builds are operational accelerators and may not redefine canonical document structure.",
  "type": "object",
  "required": [
    "index_build_id",
    "schema_type",
    "schema_version",
    "status",
    "index_kind",
    "index_profile",
    "source_chunk_set_id",
    "index_activity_id",
    "created_at",
    "boundary_controls"
  ],
  "properties": {
    "index_build_id": {
      "type": "string",
      "pattern": "^IDX-[0-9]{6}$"
    },
    "schema_type": {
      "type": "string",
      "const": "index-build"
    },
    "schema_version": {
      "type": "string",
      "const": "v1"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "superseded",
        "retired"
      ]
    },
    "index_kind": {
      "type": "string",
      "enum": [
        "lexical",
        "vector",
        "hybrid"
      ]
    },
    "index_profile": {
      "type": "string",
      "minLength": 2
    },
    "source_chunk_set_id": {
      "type": "string",
      "pattern": "^CS-[0-9]{6}$"
    },
    "source_embedding_set_id": {
      "type": "string",
      "pattern": "^ES-[0-9]{6}$"
    },
    "index_activity_id": {
      "type": "string",
      "minLength": 2
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "boundary_controls": {
      "type": "object",
      "required": [
        "depends_on_canonical_chunk_boundaries",
        "may_redefine_canonical_boundaries"
      ],
      "properties": {
        "depends_on_canonical_chunk_boundaries": {
          "type": "boolean",
          "const": true
        },
        "may_redefine_canonical_boundaries": {
          "type": "boolean",
          "const": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
