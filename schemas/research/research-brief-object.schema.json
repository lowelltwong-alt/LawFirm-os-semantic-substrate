{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lawfirm-os.example/schemas/research/research-brief-object.schema.json",
  "title": "Research Brief Object",
  "description": "Draft Phase 2 local research brief that can inform assumptions or opportunities without becoming authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "brief_id",
    "schema_type",
    "schema_version",
    "request_id",
    "source_refs",
    "summary",
    "claims",
    "affected_assumption_ids",
    "recommended_action",
    "authority_boundary"
  ],
  "properties": {
    "brief_id": {
      "type": "string",
      "pattern": "^RBR-[0-9]{6}$"
    },
    "schema_type": {
      "const": "research-brief-object"
    },
    "schema_version": {
      "const": "v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^RRQ-[0-9]{6}$"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "affected_assumption_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ASM-[0-9]{6}$"
      }
    },
    "recommended_action": {
      "enum": [
        "archive",
        "create_opportunity",
        "downgrade_green_lane",
        "request_human_review"
      ]
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_only",
        "may_create_authority",
        "human_required_for_green_restoration"
      ],
      "properties": {
        "evidence_only": {
          "const": true
        },
        "may_create_authority": {
          "const": false
        },
        "human_required_for_green_restoration": {
          "const": true
        }
      }
    }
  }
}
