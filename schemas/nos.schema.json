{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fmg.example/schemas/nos.schema.json",
  "title": "Normalized Object Set",
  "type": "object",
  "required": ["nos_version", "meta", "focal_node_ids", "nodes", "relationships", "scope", "confidence"],
  "properties": {
    "nos_version": {"type": "string"},
    "meta": {"type": "object", "additionalProperties": true},
    "focal_node_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "nodes": {"type": "array", "items": {"type": "object"}},
    "relationships": {"type": "array", "items": {"type": "object"}},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "scope": {"type": "object", "additionalProperties": true},
    "confidence": {"type": "object", "additionalProperties": true},
    "change_context": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": false
}
