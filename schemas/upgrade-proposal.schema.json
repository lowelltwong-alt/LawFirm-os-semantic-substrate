{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lawfirm-os.example/schemas/upgrade-proposal.schema.json",
  "title": "LawFirm OS Orchestrator Upgrade Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "source_signal_ids",
    "target_surface",
    "upgrade_hypothesis",
    "target_metric",
    "risk_controls",
    "shadow_eval_required",
    "approval_required",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1
    },
    "source_signal_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "target_surface": {
      "enum": [
        "prompt_template",
        "validator",
        "eval_fixture",
        "grader",
        "model_router",
        "confidence_calibration",
        "approval_threshold",
        "evidence_template",
        "tool_sandbox",
        "observability_field"
      ]
    },
    "upgrade_hypothesis": {
      "type": "string"
    },
    "target_metric": {
      "type": "string"
    },
    "expected_lift": {
      "type": [
        "number",
        "null"
      ]
    },
    "risk_controls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "shadow_eval_required": {
      "type": "boolean",
      "const": true
    },
    "approval_required": {
      "type": "boolean",
      "const": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
