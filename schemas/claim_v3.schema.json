{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Claim v3 (Address-Enforced)",
  "type": "object",
  "required": [
    "claim_id",
    "schema_type",
    "schema_version",
    "subject",
    "predicate",
    "object",
    "address",
    "address_struct"
  ],
  "properties": {
    "claim_id": {"type":"string"},
    "schema_type": {"type":"string","const":"claim"},
    "schema_version": {"type":"string","const":"v3"},
    "subject": {"type":"string"},
    "predicate": {"type":"string"},
    "object": {"type":"string"},
    "claim_type": {"type":"string"},
    "claim_mode": {"type":"string"},
    "authority_zone": {"type":"string"},
    "trust_level": {"type":"string"},
    "confidence": {"type":"number"},
    "source_refs": {"type":"array","items":{"type":"string"}},
    "evidence_refs": {"type":"array","items":{"type":"string"}},
    "artifact_refs": {"type":"array","items":{"type":"string"}},
    "derived_from_claims": {"type":"array","items":{"type":"string"}},
    "access_basis": {
      "type": "object",
      "required": ["purpose_of_use", "source_policy_refs"],
      "properties": {
        "purpose_of_use": {"type": "string", "minLength": 3},
        "source_policy_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 3}
        }
      },
      "additionalProperties": false
    },
    "address": { "$ref": "address.schema.json" },
    "address_struct": { "$ref": "address_struct.schema.json" }
  }
}
