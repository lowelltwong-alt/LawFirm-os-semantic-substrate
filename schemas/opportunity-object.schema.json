{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fmg.example/schemas/opportunity-object.schema.json",
  "title": "Opportunity Object",
  "description": "Draft v1 Innovation OS prioritization contract derived from reviewed pressure. Opportunities can rank work and prepare sprint or pilot candidates, but they cannot directly mutate canonical meaning.",
  "type": "object",
  "required": [
    "opportunity_id",
    "schema_type",
    "schema_version",
    "title",
    "status",
    "source_refs",
    "classification",
    "scoring",
    "ownership",
    "next_step",
    "mutation_boundary"
  ],
  "properties": {
    "opportunity_id": {
      "type": "string",
      "pattern": "^OPP-[0-9]{6}$"
    },
    "schema_type": {
      "type": "string",
      "const": "opportunity-object"
    },
    "schema_version": {
      "type": "string",
      "const": "v1"
    },
    "address": {
      "$ref": "address.schema.json"
    },
    "address_struct": {
      "$ref": "address_struct.schema.json"
    },
    "title": {
      "type": "string",
      "minLength": 12
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "ranked",
        "approved_for_sprint",
        "approved_for_pilot",
        "rejected",
        "converted_to_sprint",
        "converted_to_pilot",
        "superseded"
      ]
    },
    "source_refs": {
      "type": "object",
      "required": [
        "pressure_vector_ids",
        "exception_event_ids",
        "route_ids"
      ],
      "properties": {
        "pressure_vector_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^PV-[0-9]{6}$"
          }
        },
        "exception_event_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^EXC-[0-9]{6}$"
          }
        },
        "route_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^route\\.[a-z0-9_]+\\.v[0-9]+$"
          }
        },
        "supporting_artifact_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "classification": {
      "type": "object",
      "required": [
        "opportunity_class",
        "operating_domain",
        "delivery_scope"
      ],
      "properties": {
        "opportunity_class": {
          "type": "string",
          "enum": [
            "retrieval_tuning",
            "workflow_redesign",
            "governance_intervention",
            "cross_loop_initiative"
          ]
        },
        "operating_domain": {
          "type": "string",
          "enum": [
            "retrieval",
            "workflow",
            "governance",
            "cross_loop"
          ]
        },
        "delivery_scope": {
          "type": "string",
          "enum": [
            "internal_operations",
            "external_intelligence",
            "cross_loop"
          ]
        }
      },
      "additionalProperties": false
    },
    "scoring": {
      "type": "object",
      "required": [
        "impact_score",
        "recurrence_score",
        "time_to_value_score",
        "effort_score",
        "risk_score",
        "survivability_score",
        "strategic_alignment_score",
        "composite_priority_score"
      ],
      "properties": {
        "impact_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "recurrence_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dollar_effect_estimate": {
          "type": "number",
          "minimum": 0
        },
        "time_to_value_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "effort_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "risk_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "survivability_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "strategic_alignment_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "composite_priority_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "ownership": {
      "type": "object",
      "required": [
        "primary_owner",
        "ops_owner",
        "review_required"
      ],
      "properties": {
        "primary_owner": {
          "type": "string"
        },
        "ops_owner": {
          "type": "string"
        },
        "review_required": {
          "type": "boolean"
        },
        "executive_sponsor": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "validation_requirements": {
      "type": "object",
      "properties": {
        "requires_ops_validation": {
          "type": "boolean"
        },
        "requires_security_validation": {
          "type": "boolean"
        },
        "requires_legal_billing_validation": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "next_step": {
      "type": "object",
      "required": [
        "action",
        "target_family",
        "validation_gate_required"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "prepare_sprint",
            "prepare_pilot",
            "hold_for_review",
            "reject"
          ]
        },
        "target_family": {
          "type": "string",
          "enum": [
            "sprint-object",
            "pilot-object",
            "none"
          ]
        },
        "validation_gate_required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "mutation_boundary": {
      "type": "object",
      "required": [
        "no_direct_canonical_mutation",
        "promotion_decision_required_for_canonical_change",
        "allowed_runtime_actions"
      ],
      "properties": {
        "no_direct_canonical_mutation": {
          "type": "boolean",
          "const": true
        },
        "promotion_decision_required_for_canonical_change": {
          "type": "boolean",
          "const": true
        },
        "allowed_runtime_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "prioritize",
              "prepare_sprint",
              "prepare_pilot",
              "attach_supporting_evidence"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
