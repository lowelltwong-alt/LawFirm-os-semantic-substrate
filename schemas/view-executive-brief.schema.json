{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fmg.example/schemas/view-executive-brief.schema.json",
  "title": "Executive Brief View",
  "description": "Draft v1 executive brief view derived from validated exception, opportunity, and execution objects. It is a governed presentation artifact and may not bypass promotion boundaries.",
  "type": "object",
  "required": [
    "schema_id",
    "schema_type",
    "schema_version",
    "brief_id",
    "address",
    "address_struct",
    "title",
    "summary",
    "why_it_matters",
    "owner",
    "evidence_refs",
    "next_actions"
  ],
  "properties": {
    "schema_id": {
      "type": "string",
      "const": "view-executive-brief-v1"
    },
    "schema_type": {
      "type": "string",
      "const": "view-executive-brief"
    },
    "schema_version": {
      "type": "string",
      "const": "draft-v1"
    },
    "brief_id": {
      "type": "string",
      "pattern": "^EBR-[0-9]{6}$"
    },
    "address": {
      "$ref": "address.schema.json"
    },
    "address_struct": {
      "$ref": "address_struct.schema.json"
    },
    "title": {
      "type": "string",
      "minLength": 12
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review_ready",
        "superseded"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 24
    },
    "why_it_matters": {
      "type": "string",
      "minLength": 24
    },
    "owner": {
      "type": "string",
      "minLength": 3
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 4
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "next_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 4
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
