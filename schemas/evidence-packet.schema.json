{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lawfirm-os.example/schemas/evidence-packet.schema.json",
  "title": "LawFirm OS Orchestrator Evidence Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "run_id",
    "lineage_root_id",
    "trace_id",
    "correlation_id",
    "manifest_id",
    "manifest_hash",
    "policy_bundle_id",
    "synthetic",
    "route_decision",
    "proposal",
    "validation_results",
    "source_claim_refs",
    "message_history",
    "human_review_required",
    "packet_hash",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "lineage_root_id": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "span_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "manifest_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "policy_bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "synthetic": {
      "type": "boolean",
      "const": true
    },
    "route_decision": {
      "type": "object",
      "additionalProperties": true
    },
    "proposal": {
      "type": "object",
      "additionalProperties": true
    },
    "validation_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "source_claim_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "message_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "human_review_required": {
      "type": "boolean"
    },
    "lake_handoff": {
      "type": "object",
      "additionalProperties": true
    },
    "packet_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
