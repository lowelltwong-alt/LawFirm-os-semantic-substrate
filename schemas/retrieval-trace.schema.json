{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fmg.example/schemas/retrieval-trace.schema.json",
  "title": "Retrieval Trace",
  "description": "Active v1 derived observability artifact for retrieval execution. Traces capture adapter runs, scores, access-policy enforcement, and telemetry lineage without becoming canonical evidence or semantic authority.",
  "type": "object",
  "required": [
    "retrieval_trace_id",
    "schema_type",
    "schema_version",
    "retrieval_request_id",
    "status",
    "adapter_runs",
    "policy_enforcement",
    "result_trace",
    "observability"
  ],
  "properties": {
    "retrieval_trace_id": {
      "type": "string",
      "pattern": "^RT-[0-9]{6}$"
    },
    "schema_type": {
      "type": "string",
      "const": "retrieval-trace"
    },
    "schema_version": {
      "type": "string",
      "const": "v1"
    },
    "retrieval_request_id": {
      "type": "string",
      "pattern": "^RQ-[0-9]{6}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "partial",
        "empty",
        "failed"
      ]
    },
    "adapter_runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "adapter_profile_id",
          "source_system",
          "engine_kind",
          "query_activity_id"
        ],
        "properties": {
          "adapter_profile_id": {
            "type": "string"
          },
          "source_system": {
            "type": "string"
          },
          "engine_kind": {
            "type": "string",
            "enum": [
              "lexical",
              "dense",
              "fusion",
              "graph_guided",
              "metadata_only"
            ]
          },
          "index_build_id": {
            "type": "string",
            "pattern": "^IDX-[0-9]{6}$"
          },
          "query_activity_id": {
            "type": "string"
          },
          "returned_candidate_count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "policy_enforcement": {
      "type": "object",
      "required": [
        "access_decision_id",
        "deny_by_default_applied",
        "quarantine_excluded_by_default"
      ],
      "properties": {
        "access_decision_id": {
          "type": "string",
          "pattern": "^AD-[0-9]{6}$"
        },
        "deny_by_default_applied": {
          "type": "boolean",
          "const": true
        },
        "quarantine_excluded_by_default": {
          "type": "boolean",
          "const": true
        },
        "adapter_filter_expression": {
          "type": "string"
        },
        "privilege_filters_applied": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "result_trace": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rank",
          "chunk_id",
          "document_version_id",
          "scores"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "chunk_id": {
            "type": "string",
            "pattern": "^CHK-[0-9]{6}$"
          },
          "document_version_id": {
            "type": "string",
            "pattern": "^DV-[0-9]{6}$"
          },
          "scores": {
            "type": "object",
            "properties": {
              "lexical_rank": {
                "type": "integer",
                "minimum": 0
              },
              "dense_rank": {
                "type": "integer",
                "minimum": 0
              },
              "fusion_score": {
                "type": "number"
              },
              "reranker_score": {
                "type": "number"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "observability": {
      "type": "object",
      "required": [
        "trace_id",
        "span_id",
        "emitted_field_standard_ref"
      ],
      "properties": {
        "trace_id": {
          "type": "string"
        },
        "span_id": {
          "type": "string"
        },
        "parent_span_id": {
          "type": "string"
        },
        "correlation_id": {
          "type": "string"
        },
        "emitted_field_standard_ref": {
          "type": "string",
          "const": "standards/open-telemetry-fields.md"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
