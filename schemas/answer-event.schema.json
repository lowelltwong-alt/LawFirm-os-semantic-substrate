{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fmg.example/schemas/answer-event.schema.json",
  "title": "Answer Event",
  "description": "Derived grounded-answer artifact generated from a retrieval response. Answer events may summarize or synthesize, but they must remain grounded in answer evidence that resolves back to canonical spans.",
  "type": "object",
  "required": [
    "answer_event_id",
    "schema_type",
    "schema_version",
    "status",
    "query_text",
    "retrieval_response_id",
    "answer_text",
    "grounding_status",
    "answer_evidence_ids",
    "model_profile",
    "generation_activity_id",
    "generated_at",
    "boundary_controls"
  ],
  "properties": {
    "answer_event_id": {
      "type": "string",
      "pattern": "^AE-[0-9]{6}$"
    },
    "schema_type": {
      "type": "string",
      "const": "answer-event"
    },
    "schema_version": {
      "type": "string",
      "const": "v1"
    },
    "address": {
      "$ref": "address.schema.json"
    },
    "address_struct": {
      "$ref": "address_struct.schema.json"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "superseded",
        "retracted"
      ]
    },
    "query_text": {
      "type": "string",
      "minLength": 3
    },
    "retrieval_response_id": {
      "type": "string",
      "pattern": "^RR-[0-9]{6}$"
    },
    "answer_text": {
      "type": "string",
      "minLength": 8
    },
    "grounding_status": {
      "type": "string",
      "enum": [
        "grounded",
        "partially_grounded",
        "ungrounded"
      ]
    },
    "access_basis": {
      "type": "object",
      "required": [
        "access_decision_id",
        "purpose_of_use",
        "source_policy_refs"
      ],
      "properties": {
        "access_decision_id": {
          "type": "string",
          "pattern": "^AD-[0-9]{6}$"
        },
        "purpose_of_use": {
          "type": "string",
          "minLength": 3
        },
        "source_policy_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      },
      "additionalProperties": false
    },
    "answer_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^AEV-[0-9]{6}$"
      }
    },
    "model_profile": {
      "type": "object",
      "required": [
        "model_name",
        "model_version",
        "response_mode"
      ],
      "properties": {
        "model_name": {
          "type": "string"
        },
        "model_version": {
          "type": "string"
        },
        "response_mode": {
          "type": "string",
          "enum": [
            "grounded_answer",
            "grounded_summary"
          ]
        }
      },
      "additionalProperties": false
    },
    "generation_activity_id": {
      "type": "string",
      "minLength": 2
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "boundary_controls": {
      "type": "object",
      "required": [
        "canonical_source_of_truth",
        "derived_answer_may_modify_canonical_boundary"
      ],
      "properties": {
        "canonical_source_of_truth": {
          "type": "string",
          "const": "document_version_components_and_span_selectors"
        },
        "derived_answer_may_modify_canonical_boundary": {
          "type": "boolean",
          "const": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
