{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fmg.example/schemas/gold-standard-asset.schema.json",
  "title": "Gold Standard Asset",
  "description": "Draft canonical KM backbone asset. Gold Standard assets designate stewarded, source-aligned content for KM and search use while staying anchored to canonical documents, versions, components, exact spans, and policy references.",
  "type": "object",
  "required": [
    "gold_standard_asset_id",
    "schema_type",
    "schema_version",
    "lifecycle_status",
    "asset_kind",
    "document_id",
    "document_version_id",
    "component_ids",
    "span_selector_ids",
    "access_policy_ref",
    "scope_refs",
    "source_artifact_refs",
    "boundary_controls"
  ],
  "properties": {
    "gold_standard_asset_id": {
      "type": "string",
      "pattern": "^GSA-[0-9]{6}$"
    },
    "schema_type": {
      "type": "string",
      "const": "gold-standard-asset"
    },
    "schema_version": {
      "type": "string",
      "const": "v1"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "display_label": {
      "type": "string",
      "minLength": 3
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "approved",
        "active",
        "deprecated"
      ]
    },
    "asset_kind": {
      "type": "string",
      "enum": [
        "approved-answer-source",
        "guideline",
        "precedent",
        "exemplar",
        "reference-standard",
        "other"
      ]
    },
    "document_id": {
      "type": "string",
      "pattern": "^DOC-[0-9]{6}$"
    },
    "document_version_id": {
      "type": "string",
      "pattern": "^DV-[0-9]{6}$"
    },
    "component_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CMP-[0-9]{6}$"
      }
    },
    "span_selector_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SPAN-[0-9]{6}$"
      }
    },
    "access_policy_ref": {
      "type": "string",
      "minLength": 3
    },
    "steward_ref": {
      "type": "string",
      "minLength": 2
    },
    "steward_role": {
      "type": "string",
      "minLength": 2
    },
    "scope_refs": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "jurisdiction_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "matter_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "domain_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "practice_area_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "audience_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "source_artifact_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SA-[0-9]{6}$"
      }
    },
    "alignment_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "alignment_system",
          "external_ref"
        ],
        "properties": {
          "alignment_system": {
            "type": "string",
            "minLength": 2
          },
          "external_ref": {
            "type": "string",
            "minLength": 2
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "boundary_controls": {
      "type": "object",
      "required": [
        "anchored_to_canonical_document_structure",
        "retrieval_may_not_redefine_asset_boundary",
        "vendor_labels_are_not_canonical"
      ],
      "properties": {
        "anchored_to_canonical_document_structure": {
          "type": "boolean",
          "const": true
        },
        "retrieval_may_not_redefine_asset_boundary": {
          "type": "boolean",
          "const": true
        },
        "vendor_labels_are_not_canonical": {
          "type": "boolean",
          "const": true
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "anyOf": [
        {
          "required": [
            "title"
          ]
        },
        {
          "required": [
            "display_label"
          ]
        }
      ]
    },
    {
      "anyOf": [
        {
          "required": [
            "steward_ref"
          ]
        },
        {
          "required": [
            "steward_role"
          ]
        }
      ]
    }
  ],
  "additionalProperties": false
}
