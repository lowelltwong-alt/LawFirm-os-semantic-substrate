{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fmg.example/schemas/answer-evidence.schema.json",
  "title": "Answer Evidence",
  "description": "Derived grounding evidence for an answer event. Answer evidence must preserve exact span-level traceability back to canonical source structure and may optionally reference the supporting chunk and citation artifacts used in retrieval.",
  "type": "object",
  "required": [
    "answer_evidence_id",
    "schema_type",
    "schema_version",
    "answer_event_id",
    "retrieval_response_id",
    "document_version_id",
    "component_ids",
    "span_selector_ids",
    "chunk_ids",
    "support_level",
    "confidence",
    "boundary_controls"
  ],
  "properties": {
    "answer_evidence_id": {
      "type": "string",
      "pattern": "^AEV-[0-9]{6}$"
    },
    "schema_type": {
      "type": "string",
      "const": "answer-evidence"
    },
    "schema_version": {
      "type": "string",
      "const": "v1"
    },
    "answer_event_id": {
      "type": "string",
      "pattern": "^AE-[0-9]{6}$"
    },
    "retrieval_response_id": {
      "type": "string",
      "pattern": "^RR-[0-9]{6}$"
    },
    "document_version_id": {
      "type": "string",
      "pattern": "^DV-[0-9]{6}$"
    },
    "component_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CMP-[0-9]{6}$"
      }
    },
    "span_selector_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SPAN-[0-9]{6}$"
      }
    },
    "chunk_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CHK-[0-9]{6}$"
      }
    },
    "citation_mention_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CMN-[0-9]{6}$"
      }
    },
    "support_level": {
      "type": "string",
      "enum": [
        "direct",
        "partial",
        "contextual"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence_excerpt": {
      "type": "string"
    },
    "retrieval_scores": {
      "type": "object",
      "properties": {
        "fusion_score": {
          "type": "number"
        },
        "reranker_score": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "boundary_controls": {
      "type": "object",
      "required": [
        "exact_span_traceability",
        "retrieval_artifacts_derive_from_canonical_source"
      ],
      "properties": {
        "exact_span_traceability": {
          "type": "boolean",
          "const": true
        },
        "retrieval_artifacts_derive_from_canonical_source": {
          "type": "boolean",
          "const": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
