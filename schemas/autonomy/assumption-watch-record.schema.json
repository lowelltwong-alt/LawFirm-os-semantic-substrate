{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lawfirm-os.example/schemas/autonomy/assumption-watch-record.schema.json",
  "title": "Assumption Watch Record",
  "description": "Draft Phase 2 evidence record that maps a signal to watched green-lane assumptions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "watch_record_id",
    "schema_type",
    "schema_version",
    "assumption_id",
    "signal_refs",
    "watch_result",
    "recommended_reclassification"
  ],
  "properties": {
    "watch_record_id": {
      "type": "string",
      "pattern": "^AWR-[0-9]{6}$"
    },
    "schema_type": {
      "const": "assumption-watch-record"
    },
    "schema_version": {
      "const": "v1"
    },
    "assumption_id": {
      "type": "string",
      "pattern": "^ASM-[0-9]{6}$"
    },
    "signal_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "watch_result": {
      "enum": [
        "unchanged",
        "uncertain",
        "broken"
      ]
    },
    "recommended_reclassification": {
      "enum": [
        "none",
        "green_to_yellow",
        "green_to_red"
      ]
    }
  }
}
