{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lawfirm-os.example/schemas/autonomy/green-restoration-packet.schema.json",
  "title": "Green Restoration Packet",
  "description": "Draft Phase 2 human decision packet for restoring or expanding green authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_id",
    "schema_type",
    "schema_version",
    "lane_id",
    "source_reclassification_refs",
    "evidence_refs",
    "human_decision_required",
    "status"
  ],
  "properties": {
    "packet_id": {
      "type": "string",
      "pattern": "^GRP-[0-9]{6}$"
    },
    "schema_type": {
      "const": "green-restoration-packet"
    },
    "schema_version": {
      "const": "v1"
    },
    "lane_id": {
      "type": "string",
      "pattern": "^LANE-[A-Z0-9_-]+$"
    },
    "source_reclassification_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "human_decision_required": {
      "const": true
    },
    "status": {
      "enum": [
        "draft",
        "under_human_review",
        "approved",
        "rejected"
      ]
    }
  }
}
