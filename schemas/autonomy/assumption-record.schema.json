{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lawfirm-os.example/schemas/autonomy/assumption-record.schema.json",
  "title": "Assumption Record",
  "description": "Draft Phase 2 condition that supports green-lane authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assumption_id",
    "schema_type",
    "schema_version",
    "statement",
    "applies_to_lane_ids",
    "watch_signal_classes",
    "failure_effect"
  ],
  "properties": {
    "assumption_id": {
      "type": "string",
      "pattern": "^ASM-[0-9]{6}$"
    },
    "schema_type": {
      "const": "assumption-record"
    },
    "schema_version": {
      "const": "v1"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "applies_to_lane_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "watch_signal_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "failure_effect": {
      "enum": [
        "downgrade_to_yellow",
        "downgrade_to_red"
      ]
    }
  }
}
