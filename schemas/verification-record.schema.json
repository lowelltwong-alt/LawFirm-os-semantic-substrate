{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lawfirm-os.local/schemas/verification-record.schema.json",
  "title": "VerificationRecord",
  "description": "Result of verifying a ClaimRef against its supporting SourceRefs. Verification may be performed by a model, a tool, or a human; the verifier identity and freshness window are required.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verification_record_id",
    "claim_ref_id",
    "verified_by_kind",
    "verified_by_id",
    "verdict",
    "verified_at",
    "run_id"
  ],
  "properties": {
    "schema_version": {"const": "verification_record.v1"},
    "verification_record_id": {"type": "string", "minLength": 1},
    "claim_ref_id": {"type": "string", "minLength": 1},
    "verified_by_kind": {"enum": ["model", "tool", "human"]},
    "verified_by_id": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["verified", "refuted", "inconclusive"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "freshness_window_days": {"type": "integer", "minimum": 0},
    "verified_at": {"type": "string", "format": "date-time"},
    "defect_record_id": {"type": "string", "description": "Required when verdict=refuted."},
    "run_id": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "refuted"}}, "required": ["verdict"]},
      "then": {"required": ["defect_record_id"]}
    }
  ]
}
