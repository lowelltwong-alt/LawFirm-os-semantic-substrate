{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawfirm_os.managed_patch_decision.v2",
  "title": "Managed Patch Decision",
  "description": "Machine-readable decision record required when protected repo content is replaced, deleted, regenerated, or substantially rewritten. Version 2 adds explicit merge consideration, user-intent alignment, blast-radius, hash, and high-reasoning review fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "decision_scope",
    "repo",
    "target_path",
    "change_mode",
    "protected_surface",
    "old_content_reviewed",
    "preservation_strategy",
    "reason",
    "user_intent_alignment_summary",
    "diff_review_summary",
    "merge_considered",
    "alternatives_considered",
    "automated_checks_run",
    "risk_tier",
    "human_review_required",
    "human_review_status",
    "created_by",
    "created_at"
  ],
  "properties": {
    "schema_version": { "enum": ["managed_patch_decision.v1", "managed_patch_decision.v2"] },
    "decision_id": {
      "type": "string",
      "pattern": "^mpd_[A-Za-z0-9_.:-]+$"
    },
    "decision_scope": {
      "type": "string",
      "enum": ["file", "repo", "workspace"]
    },
    "repo": { "type": "string", "minLength": 1 },
    "target_path": { "type": "string", "minLength": 1 },
    "change_mode": {
      "type": "string",
      "enum": ["preserve_and_add", "merge", "replace", "delete", "regenerate"]
    },
    "protected_surface": { "type": "boolean" },
    "old_content_reviewed": { "type": "boolean" },
    "preservation_strategy": {
      "type": "string",
      "enum": [
        "preserved_original_below_managed_block",
        "merged_old_and_new_content",
        "replacement_intentional",
        "deletion_intentional",
        "generated_artifact_regenerated_from_authority",
        "not_applicable_new_file"
      ]
    },
    "reason": { "type": "string", "minLength": 20 },
    "user_intent_alignment_summary": {
      "type": "string",
      "minLength": 20,
      "description": "Why this change matches the user's explicit design intent and LawFirm OS architecture, not just the patch author's local preference."
    },
    "diff_review_summary": {
      "type": "string",
      "minLength": 20,
      "description": "Summary of removed headings, JSON IDs/keys, public symbols, policy-bearing lines, and semantic effects."
    },
    "merge_considered": {
      "type": "boolean",
      "description": "Must be true for destructive changes to protected files."
    },
    "why_merge_not_sufficient": { "type": ["string", "null"] },
    "replacement_justification": { "type": ["string", "null"] },
    "risk_tier": {
      "type": "string",
      "enum": ["low", "medium", "high", "protected"]
    },
    "human_review_required": { "type": "boolean" },
    "human_review_status": {
      "type": "string",
      "enum": ["not_required", "pending", "approved", "rejected"]
    },
    "approver": { "type": ["string", "null"] },
    "model_review_level": {
      "type": ["string", "null"],
      "enum": [null, "standard", "high", "extra_high", "not_applicable"]
    },
    "reviewer_model": {
      "type": ["string", "null"],
      "description": "Optional model/person used for high-scrutiny review, e.g. Codex extra-high, Claude high, or human reviewer."
    },
    "old_content_sha256": {
      "type": ["string", "null"],
      "pattern": "^(sha256:)?[a-fA-F0-9]{64}$"
    },
    "new_content_sha256": {
      "type": ["string", "null"],
      "pattern": "^(sha256:)?[a-fA-F0-9]{64}$"
    },
    "removed_content_summary": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "alternatives_considered": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "automated_checks_run": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "blast_radius": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "repos_touched": { "type": "array", "items": { "type": "string" } },
        "protected_files_touched": { "type": "integer", "minimum": 0 },
        "governance_files_touched": { "type": "integer", "minimum": 0 },
        "schema_registry_files_touched": { "type": "integer", "minimum": 0 },
        "runtime_code_files_touched": { "type": "integer", "minimum": 0 }
      }
    },
    "source_refs": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "created_by": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "protected_surface": { "const": true },
          "change_mode": { "enum": ["replace", "delete", "regenerate"] }
        },
        "required": ["protected_surface", "change_mode"]
      },
      "then": {
        "properties": {
          "old_content_reviewed": { "const": true },
          "merge_considered": { "const": true },
          "human_review_required": { "const": true },
          "human_review_status": { "const": "approved" },
          "model_review_level": { "const": "extra_high" },
          "replacement_justification": { "type": "string", "minLength": 30 },
          "why_merge_not_sufficient": { "type": "string", "minLength": 20 }
        },
        "required": [
          "replacement_justification",
          "why_merge_not_sufficient",
          "model_review_level"
        ]
      }
    }
  ]
}
