{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fmg.example/schemas/validation-gate-record.schema.json",
  "title": "Validation Gate Record",
  "description": "Draft v1 policy-and-governance contract that records human gate review for Innovation OS operating objects. Gate records can constrain rollout and candidate progression, but they cannot directly mutate canonical meaning.",
  "type": "object",
  "required": [
    "gate_record_id",
    "schema_type",
    "schema_version",
    "target_ref",
    "gate_phase",
    "status",
    "gate_reviews",
    "rollout_constraints",
    "mutation_boundary"
  ],
  "properties": {
    "gate_record_id": {
      "type": "string",
      "pattern": "^VGR-[0-9]{6}$"
    },
    "schema_type": {
      "type": "string",
      "const": "validation-gate-record"
    },
    "schema_version": {
      "type": "string",
      "const": "v1"
    },
    "address": {
      "$ref": "address.schema.json"
    },
    "address_struct": {
      "$ref": "address_struct.schema.json"
    },
    "target_ref": {
      "type": "object",
      "required": [
        "schema_type",
        "object_id"
      ],
      "properties": {
        "schema_type": {
          "type": "string",
          "enum": [
            "opportunity-object",
            "sprint-object",
            "pilot-object",
            "scale-package-object"
          ]
        },
        "object_id": {
          "type": "string"
        },
        "related_opportunity_id": {
          "type": "string",
          "pattern": "^OPP-[0-9]{6}$"
        }
      },
      "additionalProperties": false
    },
    "gate_phase": {
      "type": "string",
      "enum": [
        "pre-pilot",
        "pre-scale",
        "pre-promotion"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "approved_with_monitoring",
        "rejected"
      ]
    },
    "gate_reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "gate_type",
          "decision",
          "reviewer_role"
        ],
        "properties": {
          "gate_type": {
            "type": "string",
            "enum": [
              "ops_validation",
              "security_dlp_validation",
              "legal_risk_billing_integrity_validation"
            ]
          },
          "decision": {
            "type": "string",
            "enum": [
              "approved",
              "approved_with_conditions",
              "rejected",
              "pending"
            ]
          },
          "reviewer_role": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "rollout_constraints": {
      "type": "object",
      "properties": {
        "allowed_scope": {
          "type": "string"
        },
        "requires_monitoring": {
          "type": "boolean"
        },
        "requires_executive_brief_update": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "mutation_boundary": {
      "type": "object",
      "required": [
        "no_direct_canonical_mutation",
        "promotion_decision_required_for_canonical_change",
        "promotion_candidate_only"
      ],
      "properties": {
        "no_direct_canonical_mutation": {
          "type": "boolean",
          "const": true
        },
        "promotion_decision_required_for_canonical_change": {
          "type": "boolean",
          "const": true
        },
        "promotion_candidate_only": {
          "type": "boolean",
          "const": true
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
