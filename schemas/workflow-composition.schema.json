{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawfirm-os://schemas/workflow-composition.v1",
  "title": "Workflow Composition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_id",
    "name",
    "owning_repo",
    "risk_tier",
    "steps",
    "required_skills",
    "optional_skills",
    "quality_gates",
    "gap_detection_enabled",
    "updated_at"
  ],
  "properties": {
    "workflow_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "owning_repo": {
      "type": "string"
    },
    "risk_tier": {
      "enum": [
        "low",
        "medium",
        "high",
        "protected"
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "step_id",
          "uses"
        ],
        "properties": {
          "step_id": {
            "type": "string"
          },
          "uses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "required_skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "optional_skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quality_gates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gap_detection_enabled": {
      "type": "boolean"
    },
    "updated_at": {
      "type": "string"
    }
  }
}
