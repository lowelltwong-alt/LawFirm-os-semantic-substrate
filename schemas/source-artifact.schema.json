{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fmg.example/schemas/source-artifact.schema.json",
  "title": "Source Artifact",
  "description": "Captured source artifact record for an ingested document input. Source artifacts preserve ingest provenance and original file identity, but canonical document structure is established only after normalization into document version and canonical text.",
  "type": "object",
  "required": [
    "source_artifact_id",
    "schema_type",
    "schema_version",
    "document_id",
    "source_system",
    "source_identifier",
    "capture_time",
    "mime_type",
    "checksum",
    "status"
  ],
  "properties": {
    "source_artifact_id": {
      "type": "string",
      "pattern": "^SA-[0-9]{6}$"
    },
    "schema_type": {
      "type": "string",
      "const": "source-artifact"
    },
    "schema_version": {
      "type": "string",
      "const": "v1"
    },
    "document_id": {
      "type": "string",
      "pattern": "^DOC-[0-9]{6}$"
    },
    "source_system": {
      "type": "string",
      "minLength": 2
    },
    "source_identifier": {
      "type": "string",
      "minLength": 2
    },
    "capture_time": {
      "type": "string",
      "format": "date-time"
    },
    "mime_type": {
      "type": "string",
      "minLength": 3
    },
    "checksum": {
      "type": "string",
      "minLength": 8
    },
    "status": {
      "type": "string",
      "enum": [
        "captured",
        "superseded",
        "withdrawn"
      ]
    },
    "storage_ref": {
      "type": "string"
    },
    "file_size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "parser_profile": {
      "type": "string"
    },
    "ocr_required": {
      "type": "boolean"
    },
    "ingest_activity_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
